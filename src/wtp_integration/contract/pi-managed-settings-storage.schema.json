    "pi-scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "solar"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "solar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "location",
            "day",
            "night",
            "morning",
            "evening"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "locator"
              ],
              "properties": {
                "source": {
                  "const": "locator"
                },
                "locator": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-R]{2}[0-9]{2}(?:[A-X]{2}(?:[0-9]{2})?)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "day": {
              "$ref": "#/$defs/pi-solar-ordinary"
            },
            "night": {
              "$ref": "#/$defs/pi-solar-ordinary"
            },
            "morning": {
              "$ref": "#/$defs/pi-solar-gray"
            },
            "evening": {
              "$ref": "#/$defs/pi-solar-gray"
            }
          }
        }
      }
    },
    "pi-solar-ordinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "wspr_override",
        "cw_base_hz"
      ],
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "wspr_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/pi-wspr-list"
            },
            {
              "type": "null"
            }
          ]
        },
        "cw_base_hz": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*|(?:0|[1-9][0-9]*)\\.[0-9]{0,8}[1-9])$",
              "maxLength": 32768,
              "x-maxUtf8Bytes": 32768
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pi-wspr-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
