# Explicit software-runtime qualification; never an installation target.
if(NOT MSVC OR MSVC_VERSION LESS 1951)
    message(FATAL_ERROR "Controller runtime qualification requires MSVC 19.51 or later")
endif()
if(NOT NATIVE_BOTAN_LIBRARY OR NOT NATIVE_OPENSSL_SSL OR NOT NATIVE_SQLITE_LIBRARY)
    message(FATAL_ERROR "Controller runtime fixtures require the verified Botan, OpenSSL, and SQLite roots")
endif()
set(WSPRRYPI_CONTROLLER_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." CACHE PATH "Exact candidate controller src directory")
set(WSPRRYPI_CONTROLLER_METADATA_DIR "" CACHE PATH "Verified candidate generated build metadata directory")
if(NOT EXISTS "${WSPRRYPI_CONTROLLER_METADATA_DIR}/build_metadata.hpp")
    message(FATAL_ERROR "Select the candidate build_metadata.hpp explicitly; unknown provenance is not a fallback")
endif()
if(NOT EXISTS "${WSPRRYPI_CONTROLLER_METADATA_DIR}/recovery_age_image.inc")
    message(FATAL_ERROR "Select the verified candidate embedded recovery helper image explicitly")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
get_filename_component(controller_src "${WSPRRYPI_CONTROLLER_SOURCE_ROOT}" ABSOLUTE)
set(controller_generated "${CMAKE_CURRENT_BINARY_DIR}/controller-runtime-generated")
file(MAKE_DIRECTORY "${controller_generated}")
configure_file("${WSPRRYPI_CONTROLLER_METADATA_DIR}/build_metadata.hpp" "${controller_generated}/build_metadata.hpp" COPYONLY)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${controller_src}/../scripts/generate_backend_capabilities.py"
    --backends= --profile controller --ancillary-gpio 0 --output "${controller_generated}/backend_capabilities.hpp"
    RESULT_VARIABLE capabilities_result)
if(NOT capabilities_result EQUAL 0)
    message(FATAL_ERROR "Controller zero-backend capability generation failed")
endif()
file(READ "${controller_src}/../scripts/controller_sources.mk" controller_text)
string(REPLACE "\r" "" controller_text "${controller_text}")
string(REGEX REPLACE "#[^\n]*" "" controller_text "${controller_text}")
string(REPLACE "\\\n" "\n" controller_text "${controller_text}")
string(REPLACE "\n" ";" controller_lines "${controller_text}")
set(controller_sources)
foreach(entry IN LISTS controller_lines)
    string(STRIP "${entry}" entry)
    string(REGEX REPLACE "^\./" "" entry "${entry}")
    if(entry STREQUAL "" OR entry MATCHES "^#" OR entry MATCHES "^CONTROLLER_CPP_SOURCES :=")
        continue()
    endif()
    if(NOT entry MATCHES "^[A-Za-z0-9_./+-]+\\.cpp$" OR entry MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${controller_src}/${entry}")
        message(FATAL_ERROR "Invalid or missing controller source: ${entry}")
    endif()
    if(NOT entry STREQUAL "main.cpp")
        list(APPEND controller_sources "${controller_src}/${entry}")
    endif()
endforeach()
list(LENGTH controller_sources controller_source_count)
if(controller_source_count LESS 100)
    message(FATAL_ERROR "Controller source inventory is incomplete")
endif()
add_library(native_controller_runtime_objects OBJECT EXCLUDE_FROM_ALL ${controller_sources})
target_compile_features(native_controller_runtime_objects PUBLIC cxx_std_20)
target_compile_definitions(native_controller_runtime_objects PUBLIC WINVER=0x0A00 _WIN32_WINNT=0x0A00 LIB_JOURNALD=0 GPIOD_API_MAJOR=0)
# Match the existing full-controller build rather than modernizing portable
# components as an incidental fixture change. Fixture frontends retain /W4.
target_compile_options(native_controller_runtime_objects PRIVATE /W3 /WX /permissive- /utf-8 /MP2 /UNDEBUG)
set_source_files_properties("${controller_src}/WSPR-Reference/src/wspr/wspr_ref_encoder.cpp"
    PROPERTIES COMPILE_DEFINITIONS _CRT_SECURE_NO_WARNINGS)
target_include_directories(native_controller_runtime_objects PUBLIC "${controller_generated}" "${WSPRRYPI_CONTROLLER_METADATA_DIR}" "${controller_src}"
    "${NATIVE_BOTAN_INCLUDE}" "${NATIVE_OPENSSL_INCLUDE}" "${NATIVE_SQLITE_INCLUDE}")
foreach(component Chipset-Offsets/src Mailbox/src PPM-Manager/src INI-Handler/src LCBLog/src Signal-Handler/src Singleton/src
    WSPR-Reference/src/wspr WSPR-Transmitter/src WTP-Client/include WTP-Server/include)
    target_include_directories(native_controller_runtime_objects PUBLIC "${controller_src}/${component}")
endforeach()
target_link_libraries(native_controller_runtime_objects PUBLIC "${NATIVE_BOTAN_LIBRARY}" "${NATIVE_OPENSSL_SSL}"
    "${NATIVE_OPENSSL_CRYPTO}" "${NATIVE_SQLITE_LIBRARY}" setupapi cfgmgr32 advapi32 ws2_32 bcrypt shell32 ole32 uuid
    iphlpapi crypt32 mincore psapi dnsapi)

add_executable(wsprrypi_controller EXCLUDE_FROM_ALL "${controller_src}/main.cpp" "${controller_src}/native_windows_controller.manifest")
set_target_properties(wsprrypi_controller PROPERTIES OUTPUT_NAME wsprrypi)
target_link_libraries(wsprrypi_controller PRIVATE native_controller_runtime_objects)
target_compile_options(wsprrypi_controller PRIVATE /W3 /WX /permissive- /utf-8)

add_executable(pico_controller_pair_fixture EXCLUDE_FROM_ALL ../pico_controller_pair_fixture.cpp "${controller_src}/native_windows_controller.manifest")
target_link_libraries(pico_controller_pair_fixture PRIVATE native_controller_runtime_objects)
target_compile_options(pico_controller_pair_fixture PRIVATE /W4 /WX /permissive- /utf-8 /UNDEBUG)
# This fixture needs explicitly selected software peers. CTest must not launch it.
add_executable(pico_tls_server EXCLUDE_FROM_ALL ../native_windows_peer_proxy.cpp)
target_include_directories(pico_tls_server PRIVATE ../..)
target_compile_features(pico_tls_server PRIVATE cxx_std_20)
target_compile_definitions(pico_tls_server PRIVATE WINVER=0x0A00 _WIN32_WINNT=0x0A00)
target_compile_options(pico_tls_server PRIVATE /W4 /WX /permissive- /utf-8 /UNDEBUG)
target_link_libraries(pico_tls_server PRIVATE ws2_32 advapi32 shell32)

add_executable(pico_management_usb_pair_client EXCLUDE_FROM_ALL ../pico_management_usb_pair_client.cpp "${controller_src}/native_windows_controller.manifest")
target_include_directories(pico_management_usb_pair_client PRIVATE ../..)
target_link_libraries(pico_management_usb_pair_client PRIVATE native_controller_runtime_objects)
target_compile_options(pico_management_usb_pair_client PRIVATE /W4 /WX /permissive- /utf-8 /UNDEBUG)
