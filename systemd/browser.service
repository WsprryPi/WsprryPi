# Created for WsprryPi version %SEMANTIC_VERSION%
# SPDX-License-Identifier: MIT

[Unit]
Description=WsprryPi browser service
Documentation=https://github.com/orgs/WsprryPi/discussions
Wants=wsprrypi.service
After=wsprrypi.service
After=systemd-journald.service

[Service]
Type=simple
User=www-data
Group=www-data
StateDirectory=wsprrypi-web
StateDirectoryMode=0700
UMask=0077
ExecStart=%EXEC_START%
SyslogIdentifier=%SYSLOG_IDENTIFIER%
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/lib/wsprrypi
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
