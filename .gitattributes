# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.h text
*.cpp text
*.hpp text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.pdf binary
*.ico binary

# Unified diff syntax includes context-marker spaces that are not file defects.
tools/rp1_gpclk_provider/kernel/*.patch -whitespace

# These imported Markdown files intentionally use two-space hard line breaks.
WsprryPi-UI/API_syslog.md whitespace=-trailing-space
WsprryPi-UI/DESIGN.md whitespace=-trailing-space
